# Copy to .env and fill in. Never commit .env (§31 — no secrets in the image).
#
#   cp .env.example .env

# ── Site ─────────────────────────────────────────────────────────────────────
# The real production origin, no trailing slash. This is baked into prerendered
# canonical tags, Open Graph URLs, robots.txt and the sitemap at BUILD time, so
# changing it means rebuilding the web image.
NUXT_PUBLIC_SITE_URL=https://your-domain.com

# Set to false to hide the contact form and show the email address instead.
NUXT_PUBLIC_CONTACT_ENABLED=true

# Where the web container publishes. Keep it on loopback in production and let
# Nginx or a Cloudflare Tunnel terminate TLS in front of it.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
# Passed to the Go build as the version reported by /health.
VERSION=dev

# ── Database ─────────────────────────────────────────────────────────────────
# Generate each of these, do not reuse a password from elsewhere:
#   openssl rand -base64 32
DB_NAME=portfolio
DB_USER=portfolio_app
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── First admin account ──────────────────────────────────────────────────────
# Created when the API starts and finds no accounts, and never again after.
# Sign in, change the password in the panel, then delete SEED_ADMIN_PASSWORD
# here. At least 8 characters. Leave both empty to use adminctl instead.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Submissions allowed per client IP per window on POST /v1/contact.
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=1h

# Login attempts per IP. Tighter than the contact limit on purpose: this is the
# endpoint where guessing is the attack.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15m

# ── Admin ────────────────────────────────────────────────────────────────────
# Session cookies carry Secure. The API refuses to start with APP_ENV=production
# and this set to false, because the cookie would otherwise travel in plaintext
# on any non-TLS hop.
SECURE_COOKIES=true

# Admin payloads carry full case-study text, so they need a larger cap than a
# contact message.
MAX_ADMIN_BODY_BYTES=262144

# Create the first account after the stack is up:
#   docker compose exec api adminctl create -email you@example.com -name "Your Name"
