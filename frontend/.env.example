# Local frontend development only. The root .env.example covers the full stack.

# Canonical origin used for SEO. Leave as localhost locally — robots.txt then
# disallows crawling automatically.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Go API is listening. Server-side only; never exposed to the browser.
NUXT_API_BASE_URL=http://localhost:8080
NUXT_API_TIMEOUT_MS=8000

NUXT_PUBLIC_CONTACT_ENABLED=true

# Google Search Console HTML-tag verification. Paste the code (or the whole
# <meta> tag) Search Console gives you; leave empty if you verify through DNS.
# See docs/SEARCH_CONSOLE.md.
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# The admin panel lives at /admin and talks to the Go API through this server.
# Create the first account with: cd backend && go run ./cmd/adminctl create …
