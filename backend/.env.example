# Local backend development only. The root .env.example covers the full stack.
#
#   cp .env.example .env
#
# This file is loaded automatically at startup. A variable already present in
# the real environment always wins, so Docker Compose and systemd are
# unaffected by one being present. Set ENV_FILE to load a different path.

APP_ENV=development
HOST=127.0.0.1
PORT=8080

# Set DB_ENABLED=false to run the API without MySQL. Submissions are then
# rejected with a 500 rather than silently dropped.
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_app
DB_USER=root
DB_PASSWORD=root

# Pending migrations are applied when the API starts. Set false to apply them
# yourself with scripts/migrate.sh.
DB_AUTO_MIGRATE=true

# The public site the admin panel's SEO check crawls. Empty turns the check
# off. Falls back to NUXT_PUBLIC_SITE_URL when that is set instead. Locally,
# http://localhost:3000 checks the dev frontend.
SITE_URL=

# Image uploads, stored in a Cloudflare R2 bucket (docs/CONTENT.md, "Images").
# Leave empty and image fields take a pasted link only. R2_ENDPOINT can stand
# in for R2_ACCOUNT_ID (https://<account>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Largest image accepted, in bytes (5 MB).
UPLOAD_MAX_BYTES=5242880

# First admin account, created at startup only while there are no accounts.
# Leave empty to create it with `go run ./cmd/adminctl create` instead.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=1h
MAX_BODY_BYTES=16384

# Admin panel
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15m
MAX_ADMIN_BODY_BYTES=262144

# Leave false for plain-HTTP local development: a browser will not store a
# Secure cookie over http://, so the admin panel could not sign in.
SECURE_COOKIES=false

# Only enable when something you control sets X-Real-IP / X-Forwarded-For.
# Trusting these headers on a directly exposed service lets a single client
# bypass rate limiting by rotating the value.
TRUSTED_PROXY=false
